<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Arranque automático de KUPO POS al prender la tablet (v196, Lalo
         2026-11-24: "al prender la tablet que KUPO se abra en automático,
         estilo Windows"). RECEIVE_BOOT_COMPLETED es permiso normal: se
         concede solo al instalar, sin ventana. El receptor arranca la
         actividad principal de la app; el PIN se sigue pidiendo al entrar.
         v199: SYSTEM_ALERT_WINDOW ("mostrar sobre otras apps"). En
         Android 10+ el sistema no deja arrancar una actividad desde
         segundo plano sin este permiso, por eso la tablet no abría sola
         aunque el receptor sí estaba en el APK. Es permiso especial: no
         se pide en tiempo de ejecución, se concede una sola vez desde los
         ajustes del sistema (el plugin abre esa pantalla con
         ACTION_MANAGE_OVERLAY_PERMISSION, solo cuando el usuario toca el
         botón en Administrador de licencia). El receptor NO se toca.
         v200: arranque por notificación tipo alarma (Lalo 2026-11-25). La
         tablet AUMI tiene deshabilitada de fábrica la función "mostrar
         sobre otras apps", así que ese camino está muerto en este aparato.
         El receptor ya NO abre la actividad directo (Android 10+ lo
         bloquea, BAL): publica un aviso de alta prioridad con full-screen
         intent y la app se abre sola como una alarma. Para eso hacen falta
         POST_NOTIFICATIONS (permiso de notificaciones, Android 13+) y
         USE_FULL_SCREEN_INTENT (permiso normal, se concede al instalar). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <application>
        <receiver
            android:name="com.grupobenitez.kupoautostart.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
